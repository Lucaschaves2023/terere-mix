# ── Servidor (local) ─────────────────────────────────────────────
PORT=3000

# ── Banco de Dados PostgreSQL (Supabase) ─────────────────────────
# Onde encontrar: Supabase → Settings → Database → Connection string
# Escolha "Transaction pooler" (porta 6543) para Vercel serverless
# ou "Session mode" (porta 5432) para uso geral.
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Supabase Auth — Frontend (chaves PÚBLICAS) ────────────────────
# Onde encontrar: Supabase → Settings → API → Project URL
SUPABASE_URL=https://PROJECT-REF.supabase.co

# Onde encontrar: Supabase → Settings → API Keys → Publishable key
SUPABASE_ANON_KEY=sb_publishable_...

# ── Supabase Auth — Backend (opcional, melhora performance) ──────
# Quando configurado, a autenticação admin usa verificação local (sem rede).
# Quando ausente, usa a REST API do Supabase /auth/v1/user (funciona normalmente).
# NUNCA exponha esta chave no frontend ou no repositório.
# Onde encontrar: Supabase → Settings → JWT Keys → Legacy JWT Secret
SUPABASE_JWT_SECRET=

# ── Variáveis necessárias na Vercel ──────────────────────────────
# Cadastre todas as variáveis acima em:
# Vercel → seu projeto → Settings → Environment Variables
# (exceto PORT, que a Vercel gerencia automaticamente)
